# ============ 云端模型（OpenAI 兼容）============
# 注意：base URL 与模型名要成对切换
# 官方（推荐）：
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 备用（非官方域名，使用前请自行确认归属）：
# BAILIAN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# 一份 key 同时用于「向量化」与「生成回答」
DASHSCOPE_API_KEY=sk-在这里填你的key

EMBED_MODEL=text-embedding-v4
CHAT_MODEL=qwen-plus

# ============ 财务数据缓存（可选）============
# akshare 单次取数约 2~7 秒，同一家公司会被反复问到 → 缓存在磁盘上，重启不丢
# FIN_CACHE_ENABLED=1
# FIN_CACHE_TTL=43200        # 秒，默认 12 小时

# ============ 检索（可选）============
# 用哪套向量索引：base（原始）| llmctx（LLM 专属上下文，实测 MRR 0.7679 → 0.8925）
# 对应文件不存在时自动退回 base，所以新克隆的仓库不会因此报错
RETRIEVAL_INDEX=llmctx
# 重排（rerank）：默认关。评测结论见 eval/retrieval_report.md
# RERANK_ENABLED=1
# RERANK_MODEL=qwen3-rerank

# ============ 数据库后端（sqlite | mysql）============
# 默认 sqlite：数据落 data/app.db，**零部署** —— 别人 clone 下来不配任何东西就能跑
DB_BACKEND=sqlite
#
# 想用 MySQL：把上面改成 mysql，并填下面几项（这是你自己机器的配置，.env 不进 git）
# DB_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=finagent
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=finagent
#
# Docker Compose 起 MySQL 时，上面两项口令从 .env 插值（compose 不会内置默认值）：
# MYSQL_ROOT_PASSWORD=your_root_password

# ============ 服务 ============
HOST=127.0.0.1
PORT=8000

# ============ 限制项（可选，不填用默认值）============
# MAX_MODEL_CALLS=5           # 单轮最多几次模型调用
# MAX_OUTPUT_TOKENS=1500      # 单次回答输出上限
# TOOL_RESULT_MAX_CHARS=2400  # 单条工具结果上限（超出截断）
# REWRITE_MODEL=qwen-turbo    # 查询改写用的小模型（默认与 CHAT_MODEL 相同）
# REWRITE_MAX_TOKENS=120
# 注：「带几条历史原文」不在这里，去配置页调「保留最近原文条数」（memory_keep_recent）

# 变更类接口的管理口令（公网部署必设；不设则改配置/删文档/清记忆接口直接 403）
ADMIN_TOKEN=
